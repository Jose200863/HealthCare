<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendar cita"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/ivDoctor"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Foto del doctor"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etDoctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del doctor *"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etEspecialidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Especialidad *"
            android:inputType="text" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (dd/mm/aaaa) *"
            android:inputType="date" />

        <EditText
            android:id="@+id/etHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hora (ej. 11:00 am) *"
            android:inputType="text" />

        <EditText
            android:id="@+id/etMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Motivo de consulta (opcional)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GUARDAR"
            android:layout_marginTop="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarCitas"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="BUSCAR CITAS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarMedicos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="BUSCAR MÉDICOS" />

    </LinearLayout>
</ScrollView>